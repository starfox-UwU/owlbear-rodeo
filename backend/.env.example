# 后端环境变量参考（复制成 backend/.env 或 backend/.env.local 后按需修改）
# 读取顺序：backend/.env → backend/.env.local（后者覆盖前者）
# 说明见仓库根目录 README.md

# HTTP / Socket.IO 监听端口
PORT=9000

# 是否启用内置 STUN 服务（UDP）
STUN_ENABLED=true
STUN_PORT=3478
# STUN 在本机绑定的网卡，一般不用改
STUN_BIND_HOST=0.0.0.0

# ⭐ 客户端能访问到的地址（裸 IP 或域名，不要带 http:// 和端口）。
#    设置后会被自动注入到 /iceservers 返回的列表里。
#    局域网：填写宿主机局域网 IP，例如 192.168.1.32
#    公网  ：填写公网域名或 IP，并在防火墙放行 UDP STUN_PORT
# STUN_PUBLIC_HOST=192.168.1.32

# 上传资源的对外访问前缀（Docker Compose 会用到）
# ASSET_PUBLIC_URL=http://192.168.1.32:9000

# 资源缓存目录与过期时间
# ASSET_CACHE_DIR=./cache/assets
# ASSET_CACHE_TTL_MS=86400000
# ASSET_CACHE_POST_GAME_TTL_MS=900000
