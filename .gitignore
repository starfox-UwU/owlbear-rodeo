/coverage

# production
/build
/dist

# 角色卡子应用（character-card）的构建产物与依赖，
# 由 `yarn card:build`（或 predev/prebuild 钩子）生成到 public/card。
/public/card
/character-card/node_modules
/character-card/dist
/character-card/dist-standalone
/character-card/dist-automation
/character-card/test-results
/character-card/playwright-report
/character-card/.local-evidence
/character-card/verify-host-*.png

# runtime asset cache (see backend ASSET_CACHE_DIR)
/cache

# 本地临时产物（状态展示排版预览等），见 README「指示物状态展示」
/tmp

# misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*

