# 前端环境变量参考（复制成 .env 后按需修改，不要直接改这个文件）
#
# ⚠️ VITE_BROKER_URL 是「浏览器」去连后端的地址，不是 Node 进程的地址。
#    localhost / 127.0.0.1 只在浏览器和后端跑在同一台机器时才成立。

# 本地单机开发
VITE_BROKER_URL=http://127.0.0.1:9000
# 局域网内其他设备访问（把 IP 换成宿主机的局域网地址）
# VITE_BROKER_URL=http://192.168.1.32:9000
# 公网部署
# VITE_BROKER_URL=https://your-backend.example.com

# "true" 时前端直接进入维护/离线模式
VITE_MAINTENANCE=false

# 部署在子路径时设置，默认 /
# VITE_BASE=/
